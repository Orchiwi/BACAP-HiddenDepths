tellraw @s [{"text":"\n== Hidden Depths diagnostics ==\n","color":"gold","bold":true}]
tellraw @s [{"text":"Run this twice ~10s apart. The counters below MUST rise.","color":"dark_gray","italic":true}]
tellraw @s [{"text":"tick     : ","color":"gray"},{"score":{"name":"#hb_tick","objective":"bacaphd_sys"},"color":"white"}]
tellraw @s [{"text":"bucket_fast  : ","color":"gray"},{"score":{"name":"#hb_fast","objective":"bacaphd_sys"},"color":"white"}]
tellraw @s [{"text":"bucket_medium: ","color":"gray"},{"score":{"name":"#hb_medium","objective":"bacaphd_sys"},"color":"white"}]
tellraw @s [{"text":"bucket_slow  : ","color":"gray"},{"score":{"name":"#hb_slow","objective":"bacaphd_sys"},"color":"white"}]
tellraw @s [{"text":"players seen : ","color":"gray"},{"score":{"name":"#players","objective":"bacaphd_sys"},"color":"yellow"}]
execute unless score #hb_tick bacaphd_sys matches 1.. run tellraw @s [{"text":"!! tick never ran - the pack is loaded but its tick function is not firing","color":"red"}]
execute unless score #hb_medium bacaphd_sys matches 1.. run tellraw @s [{"text":"!! bucket_medium never ran - most detectors live here","color":"red"}]
tellraw @s [{"text":"\nBACAP settings seen by this pack:","color":"gold"}]
tellraw @s [{"text":"  coop: ","color":"gray"},{"score":{"name":"coop","objective":"bac_settings"},"color":"aqua"}]
tellraw @s [{"text":"  task: ","color":"gray"},{"score":{"name":"task","objective":"bac_settings"},"color":"aqua"}]
tellraw @s [{"text":"  goal: ","color":"gray"},{"score":{"name":"goal","objective":"bac_settings"},"color":"aqua"}]
tellraw @s [{"text":"  challenge: ","color":"gray"},{"score":{"name":"challenge","objective":"bac_settings"},"color":"aqua"}]
execute unless score task bac_settings matches -2..2 run tellraw @s [{"text":"!! bac_settings not found - BACAP is not installed or has not loaded","color":"red"}]
scoreboard players set #diag_have bacaphd_sys 0
tellraw @s [{"text":"\nIf every counter above is rising and you still get nothing,","color":"dark_gray","italic":true}]
tellraw @s [{"text":"the detectors are running but their conditions are not being met.","color":"dark_gray","italic":true}]
