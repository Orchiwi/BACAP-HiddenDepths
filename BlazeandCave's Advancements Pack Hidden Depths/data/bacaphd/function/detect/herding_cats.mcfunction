# B61 Herding Cats - all eleven Cat variants within eight blocks at the same moment.
# One probe per variant, so eleven bred copies of a single variant cannot pass.
# nbt={variant:"minecraft:..."} is VariantUtils.TAG_VARIANT, the form ED uses for Frogs.
execute if entity @e[type=minecraft:cat,nbt={variant:"minecraft:tabby"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:black"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:red"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:siamese"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:british_shorthair"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:calico"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:persian"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:ragdoll"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:white"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:jellie"},distance=..8,limit=1] if entity @e[type=minecraft:cat,nbt={variant:"minecraft:all_black"},distance=..8,limit=1] run advancement grant @s only bacaphd:animal/herding_cats
