execute as @a[gamemode=!spectator] at @s as @e[type=minecraft:marker,tag=bacaphd.dd,distance=..48] at @s unless entity @e[type=minecraft:zombie,distance=..4,nbt={CanBreakDoors:1b},limit=1] run kill @s
